{UTF-8}
Accumulated Waste= INTEG (
	Item Disposal Rate,
		0)
	~	items
	~		|

Awareness Generation Rate=
	Base Awareness Growth+(Availibility of Sustained Product Options*Sustainable Product Awareness per Option\
		)+(Brand Transparency Effort Level*Transparency Effectiveness)+(Circularity Promotion Initiatives\
		*Circularity Promotion Effectiveness)
	~	
	~		|

Cumulative GHG Emissions= INTEG (
	GHG Emission Rate,
		0)
	~	kg CO2e
	~		|

adoption from advertising=
	advertising effectiveness*Potential Adopters*(1-Awareness Impact on Advertising)
	~	people/Month
	~		|

adoption from word of mouth=
	contact rate*adoption fraction*Potential Adopters*(1-Awareness impact on word of mouth\
		)*(Adopters/total population)
	~	people/Month
	~		|

Availibility of Sustained Product Options=
	0.2
	~	items
	~		|

Average Consumption Rate per Adopter=
	20*Trend Speed Multiplier*Seasonal Multiplier
	~	items/people/Month
	~		|

Average GHG Emission per Item=
	25.5
	~	kg CO2e
	~		|

Average Lifespan of the item=
	2
	~	Month
	~		|

Average Water Footprint per item=
	2000
	~	liters
	~		|

"Number of Adopters Driving Consumption (Intermediary)"=
	Adopters
	~	
	~		|

Awareness Impact on Advertising=
	Consumer Awareness/Max Achievable Awareness
	~	
	~		|

Awareness impact on word of mouth=
	Consumer Awareness/Max Achievable Awareness
	~	
	~		|

Base Awareness Growth=
	0.005
	~	people/Month
	~		|

Biochemical Oxygen Demand= INTEG (
	Water Pollution Generation Rate,
		0)
	~	mg/liters
	~		|

BOD per litre of Water Used=
	6000
	~	mg/liters
	~		|

Brand Transparency Effort Level=
	0.3
	~	Dmnl
	~		|

Circularity Promotion Effectiveness=
	0.025
	~	Dmnl
	~		|

Circularity Promotion Initiatives=
	0.2
	~	Dmnl
	~		|

Consumer Awareness= INTEG (
	Awareness Generation Rate,
		0)
	~	
	~		|

GHG Emission Rate=
	Average GHG Emission per Item*Item Consumption Rate
	~	kg CO2e/Month
	~		|

Trend Speed Multiplier=
	1+(SIN(Time/2))*0.2
	~	
	~		|

Cumulative Items Consumed= INTEG (
	Item Consumption Rate,
		0)
	~	items
	~		|

Cumulative Water Used= INTEG (
	Water Consumption Rate,
		0)
	~	gallons
	~		|

Max Achievable Awareness=
	1
	~	
	~		|

Transparency Effectiveness=
	0.01
	~	people/Month
	~		|

Item Disposal Rate=
	DELAY1(Item Consumption Rate, Average Lifespan of the item)
	~	
	~		|

Item Consumption Rate=
	Average Consumption Rate per Adopter*"Number of Adopters Driving Consumption (Intermediary)"
	~	items/Month
	~		|

Seasonal Multiplier=
	1+(SIN(Time+2)*2*3.14/12)*0.15
	~	
	~		|

Sustainable Product Awareness per Option=
	0.03
	~	Dmnl
	~		|

Water Pollution Generation Rate=
	BOD per litre of Water Used*Water Consumption Rate
	~	mg/liters/Month
	~		|

Water Consumption Rate=
	Item Consumption Rate*Average Water Footprint per item
	~	liters/Month
	~		|

Adopters= INTEG (
	Item Adoption Rate,
		1000
		)
	~	people
	~		|

adoption fraction=
	0.2
	~	Dmnl
	~		|

Item Adoption Rate=
	adoption from advertising+adoption from word of mouth
	~	people/Month
	~		|

advertising effectiveness=
	0.02
	~	1/Month
	~		|

contact rate=
	20
	~	1/Month
	~		|

Potential Adopters= INTEG (
	-Item Adoption Rate,
		5.82e+07)
	~	people
	~		|

total population=
	4.49e+08
	~	people
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 60
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP 
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.125
	~	Month [0,?]
	~	The time step for the simulation.
	|

